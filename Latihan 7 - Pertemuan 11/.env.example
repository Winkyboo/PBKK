CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

# SQL Server lokal; sesuaikan hostname jika memakai named instance.
database.default.hostname = localhost
database.default.database = ShopEaseAuthDB
# Biarkan username dan password kosong untuk Windows Authentication.
database.default.username =
database.default.password =
database.default.DBDriver = SQLSRV
database.default.port = 1433
database.default.schema = dbo
database.default.charset = UTF-8
database.default.encrypt = false
