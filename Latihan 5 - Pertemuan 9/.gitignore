# Environment lokal dan rahasia
**/.env
**/.env.*
!**/.env.example

# Dependensi Composer
**/vendor/

# File runtime CodeIgniter
**/writable/cache/*
!**/writable/cache/index.html
**/writable/logs/*
!**/writable/logs/index.html
**/writable/session/*
!**/writable/session/index.html
**/writable/debugbar/*
!**/writable/debugbar/index.html
**/writable/uploads/*
!**/writable/uploads/index.html

# Laporan pengujian dan file runtime
**/tests/coverage*
**/.phpunit.cache/
**/phpunit
**/phpunit.xml
php_errors.log

# Konfigurasi mesin pengembang
.vscode/
**/.idea/
*.iml
**/.php-version

# File sementara sistem operasi
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*