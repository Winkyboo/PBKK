CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8082/'

# Local SQL Server. Leave username/password empty for Windows Authentication.
database.default.hostname = localhost
database.default.database = AnimateIkebukuroDB
database.default.username =
database.default.password =
database.default.DBDriver = SQLSRV
database.default.port = 1433
database.default.schema = dbo
database.default.charset = UTF-8
database.default.encrypt = false
