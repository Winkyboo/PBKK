<Application x:Class="BookingKampus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:BookingKampus.Helpers"
             xmlns:vm="clr-namespace:BookingKampus.ViewModels"
             xmlns:views="clr-namespace:BookingKampus.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <h:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <h:InverseBoolConverter x:Key="InvBool"/>

            <!-- Pemetaan ViewModel ke View untuk navigasi -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BookingViewModel}"><views:BookingView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ApprovalViewModel}"><views:ApprovalView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RuanganViewModel}"><views:RuanganView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FasilitasViewModel}"><views:FasilitasView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
