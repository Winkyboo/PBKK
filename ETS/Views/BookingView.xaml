<UserControl x:Class="BookingKampus.Views.BookingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:BookingKampus.Views">
    <StackPanel>
        <views:PageHeader Title="Booking ruangan" Subtitle="Ajukan pemakaian ruangan dan fasilitas, lalu pantau statusnya."/>
        <views:LoadStateStrip/>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ajukan booking" Style="{StaticResource H2}"/>

                    <TextBlock Text="Ruangan" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Ruangans}" SelectedItem="{Binding SelectedRuangan, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" AutomationProperties.Name="Ruangan"/>

                    <TextBlock Text="Tanggal" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding Tanggal, Mode=TwoWay}" DisplayDateStart="{Binding MinDate, Mode=OneWay}"
                                AutomationProperties.Name="Tanggal booking"/>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Jam mulai" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding SelectedMulai, Mode=TwoWay}" AutomationProperties.Name="Jam mulai"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Jam selesai" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding SelectedSelesai, Mode=TwoWay}" AutomationProperties.Name="Jam selesai"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Keperluan" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Keperluan, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="82" VerticalContentAlignment="Top" AutomationProperties.Name="Keperluan"/>

                    <TextBlock Text="Fasilitas yang dipakai (opsional)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Pilih ruangan untuk melihat fasilitas yang tersedia.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FasilitasChecks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding FasilitasChecks}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><CheckBox Content="{Binding Nama}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Ajukan booking" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Jadwal ruangan pada tanggal ini" Style="{StaticResource H2}"/>
                    <TextBlock Text="Cek jam yang sudah terisi sebelum mengajukan." Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                    <TextBlock Text="{Binding ScheduleHint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScheduleHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Schedule}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Waktu}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource BadgeBorder}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Keperluan}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Keperluan}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="Booking saya" Style="{StaticResource H2}" Margin="0,30,0,10"/>
        <TextBlock Text="Anda belum pernah mengajukan booking. Isi formulir di atas untuk memulai." Style="{StaticResource Muted}"
                   Visibility="{Binding IsMyEmpty, Converter={StaticResource BoolToVis}}"/>
        <DataGrid ItemsSource="{Binding MyBookings}" AutomationProperties.Name="Daftar booking saya"
                  Visibility="{Binding IsMyEmpty, Converter={StaticResource InvBoolToVis}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalText}" Width="120"/>
                <DataGridTextColumn Header="Jam" Binding="{Binding Waktu}" Width="120"/>
                <DataGridTextColumn Header="Ruangan" Binding="{Binding RuanganNama}" Width="190"/>
                <DataGridTextColumn Header="Keperluan" Binding="{Binding Keperluan}" Width="*"/>
                <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BadgeBorder}"><TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}"/></Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Catatan petugas" Binding="{Binding CatatanApprover}" Width="170"/>
                <DataGridTemplateColumn Header="Aksi" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Batalkan" Style="{StaticResource GhostButton}" Padding="12,4" MinHeight="30"
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
