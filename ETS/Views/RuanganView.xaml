<UserControl x:Class="BookingKampus.Views.RuanganView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:BookingKampus.Views">
    <StackPanel>
        <views:PageHeader Title="Ruangan" Subtitle="Daftar ruangan kampus beserta kapasitas dan fasilitasnya."/>
        <views:LoadStateStrip/>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Cari ruangan" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cari ruangan" Margin="0,0,0,14"/>
                <TextBlock Text="Tidak ada ruangan yang cocok. Ubah kata kunci atau tambahkan ruangan baru." Style="{StaticResource Muted}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          AutomationProperties.Name="Daftar ruangan"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="90"/>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="190"/>
                        <DataGridTextColumn Header="Lokasi" Binding="{Binding Lokasi}" Width="150"/>
                        <DataGridTextColumn Header="Kapasitas" Binding="{Binding Kapasitas}" Width="100"/>
                        <DataGridTextColumn Header="Fasilitas" Binding="{Binding FasilitasText}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <Grid>
                    <TextBlock Text="Hanya administrator yang dapat menambah, mengubah, atau menghapus data ruangan." Style="{StaticResource Muted}"
                               Visibility="{Binding CanEdit, Converter={StaticResource InvBoolToVis}}"/>
                    <StackPanel Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H2}"/>
                        <TextBlock Text="Kode" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Kode, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Kode ruangan"/>
                        <TextBlock Text="Nama" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Nama ruangan"/>
                        <TextBlock Text="Gedung" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Gedung, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" AutomationProperties.Name="Gedung"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Lantai" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LantaiText, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" AutomationProperties.Name="Lantai"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kapasitas" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding KapasitasText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" AutomationProperties.Name="Kapasitas"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Deskripsi" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Deskripsi, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="64" VerticalContentAlignment="Top" AutomationProperties.Name="Deskripsi"/>
                        <TextBlock Text="Fasilitas di ruangan ini" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding FasilitasChecks}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Nama}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="Ruangan aktif dan dapat dibooking" IsChecked="{Binding IsActive, Mode=TwoWay}" Margin="0,10,0,0"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Simpan" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="8,8"/>
                            <Button Grid.Column="2" Content="Baru" Command="{Binding NewItemCommand}" Style="{StaticResource GhostButton}" Padding="8,8"/>
                            <Button Grid.Column="4" Content="Hapus" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Padding="8,8"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
