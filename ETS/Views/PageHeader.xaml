<UserControl x:Class="BookingKampus.Views.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False">
    <StackPanel Margin="0,0,0,22">
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource H1}"/>
        <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource Muted}" Margin="2,2,0,0"/>
        <!-- Garis pensil ganda: motif identitas yang diulang di setiap halaman -->
        <Grid Margin="0,12,0,0" HorizontalAlignment="Left" Width="280" Height="7">
            <Rectangle Height="2" VerticalAlignment="Top" Fill="{StaticResource GraphiteBrush}" Opacity="0.85"/>
            <Rectangle Height="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="196" Fill="{StaticResource GraphiteBrush}" Opacity="0.55"/>
        </Grid>
    </StackPanel>
</UserControl>
