<UserControl x:Class="BookingKampus.Views.ApprovalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:BookingKampus.Views">
    <StackPanel>
        <views:PageHeader Title="Persetujuan" Subtitle="Tinjau pengajuan yang menunggu, lalu setujui atau tolak dengan alasan."/>
        <views:LoadStateStrip/>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Tidak ada pengajuan yang menunggu. Semua sudah diproses." Style="{StaticResource Muted}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                <DataGrid ItemsSource="{Binding Pending}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          AutomationProperties.Name="Pengajuan menunggu"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalText}" Width="120"/>
                        <DataGridTextColumn Header="Jam" Binding="{Binding Waktu}" Width="120"/>
                        <DataGridTextColumn Header="Ruangan" Binding="{Binding RuanganNama}" Width="180"/>
                        <DataGridTextColumn Header="Pemohon" Binding="{Binding PemohonNama}" Width="150"/>
                        <DataGridTextColumn Header="Keperluan" Binding="{Binding Keperluan}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <Grid>
                    <TextBlock Text="Pilih satu pengajuan di tabel untuk memprosesnya." Style="{StaticResource Muted}"
                               Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}"/>
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Detail pengajuan" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding Selected.RuanganNama}" FontWeight="Bold" FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="{Binding Selected.TanggalText, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Selected.Waktu, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Pemohon" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding Selected.PemohonNama}"/>
                        <TextBlock Text="Keperluan" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding Selected.Keperluan}" TextWrapping="Wrap"/>
                        <TextBlock Text="Fasilitas diminta" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding FasilitasText}" TextWrapping="Wrap"/>
                        <TextBlock Text="Catatan (wajib diisi jika menolak)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Catatan, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="74" VerticalContentAlignment="Top" AutomationProperties.Name="Catatan petugas"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="Setujui" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Grid.Column="2" Content="Tolak" Command="{Binding RejectCommand}" Style="{StaticResource DangerButton}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
