<UserControl x:Class="BookingKampus.Views.LoadStateStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keadaan loading dan error yang dipakai semua halaman. DataContext diwarisi dari ViewModel halaman. -->
    <StackPanel>
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,14" BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource AzureBrush}" AutomationProperties.Name="Memuat data"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,12"
                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1.5"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Muat ulang" Style="{StaticResource GhostButton}"
                        Command="{Binding LoadCommand}" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
