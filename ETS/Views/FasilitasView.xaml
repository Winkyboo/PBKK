<UserControl x:Class="BookingKampus.Views.FasilitasView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:BookingKampus.Views">
    <StackPanel>
        <views:PageHeader Title="Fasilitas" Subtitle="Perlengkapan yang melekat pada ruangan dan dapat dipilih saat booking."/>
        <views:LoadStateStrip/>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Cari fasilitas" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cari fasilitas" Margin="0,0,0,14"/>
                <TextBlock Text="Tidak ada fasilitas yang cocok. Ubah kata kunci atau tambahkan fasilitas baru." Style="{StaticResource Muted}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          AutomationProperties.Name="Daftar fasilitas"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="220"/>
                        <DataGridTextColumn Header="Deskripsi" Binding="{Binding Deskripsi}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <Grid>
                    <TextBlock Text="Hanya administrator yang dapat menambah, mengubah, atau menghapus data fasilitas." Style="{StaticResource Muted}"
                               Visibility="{Binding CanEdit, Converter={StaticResource InvBoolToVis}}"/>
                    <StackPanel Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                        <TextBlock Text="Nama" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Nama fasilitas"/>
                        <TextBlock Text="Deskripsi" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Deskripsi, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="74" VerticalContentAlignment="Top" AutomationProperties.Name="Deskripsi fasilitas"/>
                        <CheckBox Content="Fasilitas aktif" IsChecked="{Binding IsActive, Mode=TwoWay}" Margin="0,12,0,0"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Simpan" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="8,8"/>
                            <Button Grid.Column="2" Content="Baru" Command="{Binding NewItemCommand}" Style="{StaticResource GhostButton}" Padding="8,8"/>
                            <Button Grid.Column="4" Content="Hapus" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Padding="8,8"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
