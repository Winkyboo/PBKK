<UserControl x:Class="BookingKampus.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:BookingKampus.Views">
    <StackPanel>
        <views:PageHeader Title="Ringkasan" Subtitle="{Binding Sapaan}"/>
        <views:LoadStateStrip/>

        <!-- Kartu pertama sengaja lebih besar: antrean persetujuan adalah hal yang paling perlu dilihat -->
        <Grid Margin="0,0,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource AzureBrush}" CornerRadius="4" Padding="24,20" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Menunggu persetujuan" FontWeight="SemiBold" Foreground="{StaticResource InkOnAzureBrush}"/>
                    <TextBlock Text="{Binding Stats.Menunggu}" Style="{StaticResource H1}" FontSize="56" Foreground="{StaticResource InkOnAzureBrush}"/>
                    <TextBlock Text="Pengajuan yang belum diproses admin." TextWrapping="Wrap" Foreground="{StaticResource InkOnAzureBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Ruangan aktif" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Stats.RuanganAktif}" Style="{StaticResource H1}" FontSize="40"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Fasilitas aktif" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Stats.FasilitasAktif}" Style="{StaticResource H1}" FontSize="40"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Disetujui bulan ini" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Stats.DisetujuiBulanIni}" Style="{StaticResource H1}" FontSize="40"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Jadwal hari ini" Style="{StaticResource H2}"/>
                <TextBlock Text="Booking yang sudah disetujui untuk hari ini." Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                <TextBlock Text="Tidak ada booking disetujui untuk hari ini." Style="{StaticResource Muted}"
                           Visibility="{Binding TodayEmpty, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Today}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Waktu}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding RuanganNama}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Keperluan}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
