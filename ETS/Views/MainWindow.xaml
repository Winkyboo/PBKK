<Window x:Class="BookingKampus.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Booking Kampus" Width="1320" Height="800" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: bidang kuas biru dengan tepi bergerigi -->
        <Grid Grid.Column="0" Panel.ZIndex="1">
            <Border Background="{StaticResource AzureBrush}"/>
            <Path Data="{StaticResource BrushEdge}" Fill="{StaticResource AzureBrush}" Stretch="Fill"
                  Width="16" HorizontalAlignment="Right" Margin="0,0,-15,0"/>
            <DockPanel Margin="18,26,22,22">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
                    <TextBlock Text="Booking Kampus" Style="{StaticResource H1}" FontSize="28"
                               Foreground="{StaticResource InkOnAzureBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Ruangan dan fasilitas" Foreground="{StaticResource InkOnAzureBrush}" Margin="2,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,16,0,0">
                    <TextBlock Text="{Binding UserName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource InkOnAzureBrush}"/>
                    <TextBlock Text="{Binding RoleText}" Foreground="{StaticResource InkOnAzureBrush}" Margin="0,0,0,10"/>
                    <Button Content="Keluar" Command="{Binding LogoutCommand}" Style="{StaticResource GhostButton}"
                            Foreground="{StaticResource InkOnAzureBrush}" BorderBrush="{StaticResource InkOnAzureBrush}"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Menu utama">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- Area konten -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="44,34,44,34" IsTabStop="False"/>
        </ScrollViewer>

        <!-- Notifikasi hasil aksi (toast) -->
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,28,0" Padding="18,12"
                CornerRadius="4" MaxWidth="460" Panel.ZIndex="5"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                AutomationProperties.LiveSetting="Assertive">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource InkOnAzureBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastText}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
