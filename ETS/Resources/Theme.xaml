<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Palet (dari referensi pengguna: sapuan kuas biru di atas kertas, garis pensil grafit) =====
         Azure       : warna sapuan kuas. Dipakai untuk bidang besar (sidebar, kartu fokus, batang grafik), teks di atasnya memakai InkOnAzure (kontras 5.1:1).
         InkBlue     : satu-satunya aksen untuk aksi utama dan fokus input (putih di atasnya 5.5:1).
         Paper/Card  : latar kertas dan kartu putih.
         Graphite    : teks dan garis pensil. -->
    <SolidColorBrush x:Key="AzureBrush" Color="#3AA0E8"/>
    <SolidColorBrush x:Key="AzureSoftBrush" Color="#D9EDFB"/>
    <SolidColorBrush x:Key="InkBlueBrush" Color="#0B6BB8"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#F4F4F1"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GraphiteBrush" Color="#2B3036"/>
    <SolidColorBrush x:Key="GraphiteSoftBrush" Color="#4D555D"/>
    <SolidColorBrush x:Key="PencilBrush" Color="#7A828A"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#D5DAE0"/>
    <SolidColorBrush x:Key="InkOnAzureBrush" Color="#0F2A44"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#A4262C"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E6EAEE"/>
    <SolidColorBrush x:Key="HoverOnAzureBrush" Color="#66FFFFFF"/>

    <!-- Huruf tulis tangan hanya untuk judul, meniru huruf pada referensi. Isi memakai Segoe UI agar terbaca. -->
    <FontFamily x:Key="HeadingFont">Ink Free, Segoe Print, Segoe UI</FontFamily>

    <!-- Tepi sapuan kuas yang bergerigi (motif identitas, dipakai di sidebar dan panel login). -->
    <Geometry x:Key="BrushEdge">M0,0 L10,0 L6,16 L11,32 L5,46 L10,62 L4,78 L9,94 L5,110 L11,126 L6,142 L10,158 L5,174 L9,190 L4,206 L10,222 L6,238 L11,254 L5,270 L9,286 L4,300 L0,300 Z</Geometry>

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ===== Teks ===== -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GraphiteSoftBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GraphiteSoftBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>

    <!-- ===== Kartu ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- ===== Fokus keyboard: garis putus-putus grafit, seperti garis bantu pensil ===== -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource GraphiteBrush}" StrokeThickness="2"
                               StrokeDashArray="3 2" RadiusX="4" RadiusY="4" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tombol ===== -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
        <Setter Property="Background" Value="{StaticResource InkBlueBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InkBlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- ===== Input ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PencilBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AzureBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InkBlueBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PencilBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AzureBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InkBlueBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
    </Style>

    <!-- ===== Navigasi sidebar ===== -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Foreground" Value="{StaticResource InkOnAzureBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Margin="0,2" Padding="16,11" CornerRadius="3" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{StaticResource InkOnAzureBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOnAzureBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PaperBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lencana status: warna selalu disertai teks ===== -->
    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="#E3E5E8"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Menunggu"><Setter Property="Background" Value="#FFF1C9"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Disetujui"><Setter Property="Background" Value="#D6F0DC"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Ditolak"><Setter Property="Background" Value="#FBD9DB"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#3A4047"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Menunggu"><Setter Property="Foreground" Value="#6B4A00"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Disetujui"><Setter Property="Foreground" Value="#14532D"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Ditolak"><Setter Property="Foreground" Value="#7A1A1F"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tabel ===== -->
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource AzureSoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="BorderBrush" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style x:Key="GridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AzureSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AzureSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource GridCell}"/>
        <Setter Property="MaxHeight" Value="380"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

</ResourceDictionary>
