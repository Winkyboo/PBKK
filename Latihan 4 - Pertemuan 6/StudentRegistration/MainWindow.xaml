<Window x:Class="StudentRegistration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration - Cyberpunk Dashboard" 
        Height="700" Width="1200"
        Background="#0F111A"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- DataGrid Main Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#16192B"/>
            <Setter Property="RowBackground" Value="#16192B"/>
            <Setter Property="AlternatingRowBackground" Value="#1D2136"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2A2F4C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2A2F4C"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Column Header Styling -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#232742"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#2A2F4C"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- DataGrid Cell Styling -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#7000FF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row Hover State -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D3352"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Dashboard -->
            <ColumnDefinition Width="280"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR STATISTICS ================= -->
        <Border Grid.Column="0" Background="#16192B" BorderBrush="#2A2F4C" BorderThickness="0,0,1,0" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Brand Title -->
                    <Border BorderBrush="#00F0FF" BorderThickness="0,0,0,2" Padding="0,0,0,12" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="// CYBERDASH v2.0" Foreground="#FF0055" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="STUDENT METRICS" Foreground="#00F0FF" FontFamily="Consolas, Segoe UI" FontSize="18" FontWeight="Black" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat Card 1: Total Students -->
                    <Border Background="#1D2136" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="TOTAL MAHASISWA" Foreground="#A0AEC0" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="TxtTotalStudents" Text="0" Foreground="#00F0FF" FontFamily="Consolas" FontSize="32" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat Card 2: Teknik Informatika -->
                    <Border Background="#1D2136" BorderBrush="#7000FF" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="TEKNIK INFORMATIKA (TI)" Foreground="#A0AEC0" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="TxtTotalTC" Text="0" Foreground="#BD00FF" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat Card 3: Sistem Informasi -->
                    <Border Background="#1D2136" BorderBrush="#FF0055" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="SISTEM INFORMASI (SI)" Foreground="#A0AEC0" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="TxtTotalSI" Text="0" Foreground="#FF0055" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat Card 4: Aktuaria -->
                    <Border Background="#1D2136" BorderBrush="#00FFD1" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Aktuaria (Akt)" Foreground="#A0AEC0" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="TxtTotalAkt" Text="0" Foreground="#00FFD1" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat Card 5: Teknik Industri -->
                    <Border Background="#1D2136" BorderBrush="#FF9D00" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="TEKNIK INDUSTRI (TI)" Foreground="#A0AEC0" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock x:Name="TxtTotalTI" Text="0" Foreground="#FF9D00" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- System Status Panel -->
                    <Border Background="#0F111A" BorderBrush="#2A2F4C" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#00FF66" Margin="0,0,10,0"/>
                            <TextBlock Text="SYSTEM: ONLINE // ADO.NET OK" Foreground="#00FF66" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= MAIN CONTENT AREA ================= -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Action Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input Bar -->
                <Border Grid.Column="0" Background="#16192B" BorderBrush="#2A2F4C" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,15,0">
                    <Grid>
                        <TextBox x:Name="TxtSearch"
                                 Background="Transparent"
                                 Foreground="#E2E8F0"
                                 BorderThickness="0"
                                 FontSize="13"
                                 FontFamily="Consolas, Segoe UI"
                                 VerticalAlignment="Center"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock Text="Cari NRP, Nama, atau Program Studi..." 
                                   Foreground="#5A6578" 
                                   FontFamily="Consolas, Segoe UI" 
                                   FontSize="13" 
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Status Info -->
                <TextBlock Grid.Column="1" 
                           x:Name="TxtStatusInfo"
                           Text="Menampilkan 0 Data" 
                           Foreground="#A0AEC0" 
                           FontFamily="Consolas" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Margin="0,0,15,0"/>

                <!-- Cyberpunk Refresh Button -->
                <Button Grid.Column="2" 
                        Content="[ ↻ REFRESH ]" 
                        Width="140" 
                        Height="38"
                        Background="#FF0055" 
                        Foreground="White" 
                        FontWeight="Bold"
                        FontSize="12"
                        FontFamily="Consolas"
                        Cursor="Hand"
                        BorderThickness="0"
                        Click="RefreshButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- DataGrid Display Container -->
            <Border Grid.Row="1" CornerRadius="6" BorderBrush="#00F0FF" BorderThickness="1" Padding="1" Background="#16192B">
                <DataGrid x:Name="StudentDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding StudentId}" Width="50"/>
                        <DataGridTextColumn Header="NRP" Binding="{Binding NRP}" Width="110"/>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Program Studi" Binding="{Binding ProgramName}" Width="160"/>
                        <DataGridTextColumn Header="Tanggal Lahir" Binding="{Binding BirthDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="No. Telepon" Binding="{Binding PhoneNumber}" Width="120"/>
                        <DataGridTextColumn Header="Alamat" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="Dibuat" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="135"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>